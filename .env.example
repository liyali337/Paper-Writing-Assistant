# 章节翻译：阿里云百炼 Qwen3.8-Max（OpenAI 兼容）。
# API Key：https://bailian.console.aliyun.com/ → API-KEY（通常 sk- 开头）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen3.8-max

# 公式多的 Method 章节建议（可选，减少 90s 超时）：
# LLM_TIMEOUT_S=180
# TRANSLATE_PARALLELISM=1
# TRANSLATE_CHUNK_MAX_CHARS=1200

# 对象存储根目录（本地起步）
DATA_DIR=./data
