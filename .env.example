# 章节翻译与公式视觉重识别：DeepSeek（OpenAI 兼容）。
# API Key：https://platform.deepseek.com/api_keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat

# 公式视觉重识别（看裁图还原 LaTeX）。未单独指定时，DeepSeek 端点默认 deepseek-flash。
FORMULA_VISION_ENABLED=true
FORMULA_VISION_MODEL=deepseek-flash
FORMULA_VISION_BASE_URL=https://api.deepseek.com/v1
# FORMULA_VISION_MAX=80

# 公式多的 Method 章节建议（可选，减少 90s 超时）：
# LLM_TIMEOUT_S=180
# TRANSLATE_PARALLELISM=1
# TRANSLATE_CHUNK_MAX_CHARS=1200

# 对象存储根目录（本地起步）
DATA_DIR=./data

# 论文问答混合检索（对齐 tutorial-agentic-rag：稠密 + BM25 稀疏，Qdrant 内 RRF）。
# 安装：pip install -e ".[rag]"
# 首次索引会下载 all-mpnet-base-v2 与 Qdrant/bm25。
# 国内连不上 huggingface.co 时，已缓存的模型会优先走本地；仍要下载可设镜像：
# HF_ENDPOINT=https://hf-mirror.com
# DENSE_MODEL=sentence-transformers/all-mpnet-base-v2
# SPARSE_MODEL=Qdrant/bm25
# QDRANT_PATH=
# QDRANT_COLLECTION=paper_child_chunks
# 也可用云端 embedding 代替本地稠密模型：
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# CHUNK_SIZE=500
# CHUNK_OVERLAP=100
# RETRIEVE_K=8
# LIBRARY_PAPER_K=6
# LIBRARY_CHUNKS_PER_PAPER=2

# 检索回答 Agent（docs/检索回答Agent.md 第 1 步）。图逻辑尚未接入。
# 安装：pip install -e ".[agent]"
# ASK_MODE=simple 时走 1 次检索 + 1 次 LLM，不跑 LangGraph。
# ASK_MODE=agent
# ASK_MAX_TOOL_CALLS=6
# ASK_MAX_ITERATIONS=8
# ASK_MAX_SUBQUESTIONS=3
# ASK_COMPRESS_TOKENS=2000
# ASK_AGENT_PROMPT_VERSION=ask-agent-v1
# orchestrator 工具协议：native=OpenAI tools（缺省）；json=手写 {"tool":...}。
# Gemini 原生端点会自动回落 json。native 若 400 也会回落一次 json。
# ASK_TOOL_PROTOCOL=native

# 论文问答框会按问句分流：精读本篇 / 本地库 / arXiv。arXiv 独立模式始终走网关，
# 命中进 external_refs，不进本篇 citations；本地标题匹配时附 library_hits 可「进入这篇」。
# ASK_ENABLE_EXTERNAL 仅给精读 Worker 额外挂 arxiv_search（默认关，避免和本篇证据混用）。
# ASK_ENABLE_EXTERNAL=false
# ARXIV_API_URL=https://export.arxiv.org/api/query
# MCP_TIMEOUT_S=30
# ARXIV_PROMPT_VERSION=arxiv-ask-v2

# Langfuse 观测（可选）。有公钥+私钥才上报；未安装 SDK 时自动跳过。
# 安装：pip install -e ".[obs]"
# 密钥只放本机 .env，不要提交。区域：EU=cloud.langfuse.com，US=us.cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING=true
